{
  "schema": "opsdevcode.release/v0",
  "repository": "opsdevcode/mint-action",
  "profile": "product",
  "canonical": "github-release",
  "engine": "release-please",
  "tagPolicy": {
    "manualTags": false,
    "retag": false,
    "pattern": "^v0\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"
  },
  "prerelease": {
    "githubMakeLatest": false
  },
  "downstream": {
    "pypi": {
      "role": "none"
    },
    "ghcr": {
      "role": "none",
      "latest": false,
      "visibilityChange": false
    },
    "marketplace": {
      "role": "none"
    },
    "openvsx": {
      "role": "none"
    },
    "pages": {
      "role": "none"
    }
  },
  "artifacts": [
    "notes"
  ],
  "provenance": {
    "synthesize": false
  },
  "notes": "Release Please owns tags after squash-merge. Consumers still pin an immutable merge SHA, never @main, @latest, or a floating v1. Language wheel comes from the specmint-language GitHub Release. githubMakeLatest stays false."
}
